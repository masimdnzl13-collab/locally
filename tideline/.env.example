APP_ENV=development
PORT=3000
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Origins allowed to embed Tideline in an iframe (CSP frame-ancestors), comma-separated.
# Unset -> only http://localhost:3001 and http://localhost:5173 (a startup warning is logged).
ALLOWED_FRAME_ANCESTORS=http://localhost:3001,https://locally-production-domain.vercel.app
POSTGRES_DB=restaurant_ai
POSTGRES_USER=restaurant_ai
POSTGRES_PASSWORD=local-dev-postgres-password
DATABASE_URL=postgresql://restaurant_ai:local-dev-postgres-password@localhost:5432/restaurant_ai
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-at-least-32-random-characters
SESSION_SECRET=replace-with-at-least-32-random-characters
LOG_LEVEL=info

# Voice and SMS provider configuration
# TELEPHONY_MODE=test simulates calls locally; twilio serves real calls and requires
# TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN and a public HTTPS VOICE_PUBLIC_URL.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_PHONE_NUMBER=+15551234567
TWILIO_VALIDATE_SIGNATURES=true
TELEPHONY_MODE=test
VOICE_PUBLIC_URL=https://your-public-api.example.com
VOICE_STREAM_PATH=/api/v1/telephony/twilio/media
# Per-caller abuse guard: after MAX calls from one number to one restaurant within
# WINDOW minutes, further calls hear MESSAGE and hang up without reaching the AI
# (each AI call costs Claude + STT + TTS). MAX=0 disables it.
CALLER_THROTTLE_MAX_CALLS=5
CALLER_THROTTLE_WINDOW_MINUTES=10
# CALLER_THROTTLE_MESSAGE=We're very busy right now. Please call again a little later. Goodbye.

# Speech-to-text: mock | deepgram (streaming nova-3, English + Spanish)
STT_PROVIDER=mock
STT_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
# Text-to-speech: mock | deepgram (Aura) | elevenlabs
TTS_PROVIDER=mock
TTS_API_KEY=
# Locale values (en-US / es-US) pick the provider's default voice; or set a
# Deepgram Aura model (aura-2-thalia-en) / ElevenLabs voice id.
VOICE_ENGLISH_VOICE=en-US
VOICE_SPANISH_VOICE=es-US

# LLM: mock | anthropic (Claude). AI_API_KEY falls back to ANTHROPIC_API_KEY.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=claude-opus-5
AI_EFFORT=low

# Admin alerts (telephony failures + cost guard). Slack incoming webhook wins;
# otherwise a plain email via Resend; otherwise alerts are only logged.
ALERT_WEBHOOK_URL=
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
# More than N 5xx/media failures on telephony routes within the window -> one alert,
# then silence for the cooldown.
TELEPHONY_ALERT_MAX_ERRORS=3
TELEPHONY_ALERT_WINDOW_SECONDS=300
TELEPHONY_ALERT_COOLDOWN_SECONDS=900

# Cost guard (worker, hourly): alert when a restaurant's month-to-date Claude +
# voice cost exceeds SUBSCRIPTION_PRICE_USD * COST_ALERT_THRESHOLD_RATIO.
# Visibility only - never suspends service. Per-minute voice rates are estimates.
SUBSCRIPTION_PRICE_USD=199
COST_ALERT_THRESHOLD_RATIO=0.6
COST_TWILIO_PER_MINUTE=0.0125
COST_STT_PER_MINUTE=0.0077
COST_TTS_PER_MINUTE=0.01
