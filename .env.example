# Bu dosya .env.local için şablondur — gerçek değerler asla buraya yazılmaz,
# yalnızca anahtar isimleri ve ne işe yaradıkları. Kopyalayıp .env.local
# olarak kaydet, gerçek değerleri oraya gir (.env.local git'e gitmez).
#
# NOT: VERCEL_OIDC_TOKEN burada yok — `vercel env pull` çalıştırdığında
# Vercel CLI onu otomatik ekler, elle girilmez.

# Supabase — hepsi zorunlu, biri eksikse uygulama başlamaz (bkz. lib/env.ts)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Yalnız sunucu tarafında (cron işleri, admin RPC'leri) kullanılır, asla client'a sızdırılmaz
SUPABASE_SERVICE_ROLE_KEY=

# Şifre sıfırlama e-postasındaki bağlantının döneceği adres (prod'da gerçek domain)
NEXT_PUBLIC_SITE_URL=

# Vercel Cron uç noktalarını dıştan çağrılamaz yapan gizli anahtar
CRON_SECRET=

# SMS (Netgsm) — boşsa duyuru aracı test modunda simüle eder
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_MSGHEADER=

# E-posta (Resend) — boşsa duyuru aracı test modunda simüle eder
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# iyzico (marketplace/pazaryeri) — boşsa ödeme akışı test modunda simüle eder.
# PILOT_MODE=true olduğu sürece (bkz. lib/config/pilot.ts) zaten kullanılmaz.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=

# Claude (Anthropic) — işletme panelindeki AI kampanya metni asistanı için.
# Boşsa lib/ai/client.ts isAiConfigured() false döner ve asistan
# lib/ai/demo-content.ts'teki sabit örnek metinlerle simüle eder.
ANTHROPIC_API_KEY=

# Tideline (ABD pazarı modülü, tideline/ alt klasörü) — SSO köprüsü.
# TIDELINE_JWT_SECRET, tideline/.env'deki JWT_SECRET ile BİREBİR aynı olmalı
# (HS256 imzalama sırrı). Boşsa /api/tideline/sso 503 döner ve sekme bağlanamaz.
# TIDELINE_WEB_URL: Tideline web uygulamasının adresi (yerelde Vite, 5173).
TIDELINE_JWT_SECRET=
TIDELINE_WEB_URL=http://localhost:5173

# PayPal — ABD pazarı (businesses.market = 'US') ödeme sağlayıcısı: abonelik
# (Subscriptions API) + etkinlik bileti (Orders API). Bkz.
# lib/payments/paypal-provider.ts. TR pazarı iyzico'da kalır.
# ŞU AN SANDBOX'TA: developer.paypal.com → Apps & Credentials → "Sandbox"
# sekmesinde bir uygulama oluştur, Client ID + Secret buraya. Boşsa abonelik ve
# bilet akışları gerçek API'ye gitmeden simüle edilir.
# PAYPAL_ENV=live yalnızca PAYPAL_LIVE_MODE=true ile kabul edilir.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_LIVE_MODE=false
# /api/webhooks/paypal için PayPal'da oluşturulan webhook'un kimliği (imza
# doğrulamasının parçası; olay listesi route dosyasında).
PAYPAL_WEBHOOK_ID=
# /kayit/us aboneliğinin PayPal Billing Plan kimliği (P-...). Sandbox'ta
# oluşturmak için: node scripts/paypal-setup-plan.mjs
PAYPAL_US_PLAN_ID=

# Stripe — ŞU AN KULLANILMIYOR (ABD pazarı PayPal'a taşındı). Kod ve
# /api/webhooks/stripe referans olarak duruyor; Stripe'ta açılmış eski
# kayıtların olayları için ya da Stripe'a dönülürse diye (bkz.
# lib/payments/stripe-provider.ts).
# ŞU AN TEST MODUNDA: yalnızca sk_test_... anahtarı kullan (Stripe Dashboard →
# Developers → API keys, "Test mode" açıkken). Ödeme sayfası Stripe'ın hosted
# Checkout'u olduğundan publishable (pk_test_) anahtara gerek yok.
# Boşsa abonelik akışı gerçek API'ye gitmeden simüle edilir.
# sk_live_... anahtarı STRIPE_LIVE_MODE=true olmadıkça reddedilir.
STRIPE_SECRET_KEY=
# /api/webhooks/stripe imza doğrulaması (whsec_...). Yerelde
# `stripe listen --forward-to localhost:3001/api/webhooks/stripe` çıktısındaki
# değer; prod'da Dashboard'daki webhook endpoint'inin signing secret'ı.
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_MODE=false
# P6 — /kayit/us aboneliğinin Stripe fiyat kimliği (price_...). Stripe
# anahtarı tanımlıyken zorunlu; anahtar yoksa ödeme test modunda simüle edilir.
STRIPE_US_PRICE_ID=

# Locally sunucusu → Tideline API (/api/v1/internal/*: self-servis restoran +
# Twilio numarası kurulumu, admin numara kuyruğu). Servis token'ı
# TIDELINE_JWT_SECRET ile imzalanır. Boşsa ABD kayıtları "24 saat içinde"
# bekleme ekranına düşer ve admin /admin/tideline-kurulum'dan tamamlar.
TIDELINE_API_URL=http://localhost:3000

# Twilio (ABD SMS) — +1 numaralara giden bildirimler (ör. P7 kış modülü
# bildirimi) Netgsm yerine buradan gider. Boşsa e-postaya (Resend) düşer.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
