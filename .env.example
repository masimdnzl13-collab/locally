# Bu dosya .env.local için şablondur — gerçek değerler asla buraya yazılmaz,
# yalnızca anahtar isimleri ve ne işe yaradıkları. Kopyalayıp .env.local
# olarak kaydet, gerçek değerleri oraya gir (.env.local git'e gitmez).
#
# NOT: VERCEL_OIDC_TOKEN burada yok — `vercel env pull` çalıştırdığında
# Vercel CLI onu otomatik ekler, elle girilmez.
#
# ÜRETİM DENETİMİ (AP): hangi değişkenlerin üretimde ZORUNLU olduğu tek yerde,
# lib/env-spec.mjs'te. Vercel production build'inde biri eksikse build durur
# (scripts/check-env.mjs, prebuild) ve sunucu açılmaz (instrumentation.ts);
# hangi değişkenin eksik olduğu log'a yazılır. Yerelde denemek için:
#   ENV_CHECK=strict node scripts/check-env.mjs
# Acil durumda atlamak: SKIP_ENV_CHECK=1 (önerilmez).

# Supabase — hepsi zorunlu, biri eksikse uygulama başlamaz (bkz. lib/env.ts)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Yalnız sunucu tarafında (cron işleri, admin RPC'leri) kullanılır, asla client'a sızdırılmaz
SUPABASE_SERVICE_ROLE_KEY=

# Şifre sıfırlama e-postasındaki bağlantının döneceği adres (prod'da gerçek domain)
NEXT_PUBLIC_SITE_URL=

# Vercel Cron uç noktalarını dıştan çağrılamaz yapan gizli anahtar
CRON_SECRET=

# SMS (Netgsm) — boşsa duyuru aracı test modunda simüle eder
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_MSGHEADER=

# E-posta (Resend) — boşsa duyuru aracı test modunda simüle eder
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# iyzico (marketplace/pazaryeri) — boşsa ödeme akışı test modunda simüle eder.
# PILOT_MODE=true olduğu sürece (bkz. lib/config/pilot.ts) zaten kullanılmaz.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=

# Claude (Anthropic) — işletme panelindeki AI kampanya metni asistanı için.
# Boşsa lib/ai/client.ts isAiConfigured() false döner ve asistan
# lib/ai/demo-content.ts'teki sabit örnek metinlerle simüle eder.
ANTHROPIC_API_KEY=

# Tideline (ABD pazarı modülü, tideline/ alt klasörü) — SSO köprüsü.
# TIDELINE_JWT_SECRET, tideline/.env'deki JWT_SECRET ile BİREBİR aynı olmalı
# (HS256 imzalama sırrı). Boşsa /api/tideline/sso 503 döner ve sekme bağlanamaz.
# TIDELINE_WEB_URL: Tideline web uygulamasının adresi (yerelde Vite, 5173).
TIDELINE_JWT_SECRET=
TIDELINE_WEB_URL=http://localhost:5173

# PayPal — ABD pazarı (businesses.market = 'US') ödeme sağlayıcısı (bkz.
# lib/payments/paypal-provider.ts): abonelik = PayPal Subscriptions, etkinlik
# bileti = PayPal Orders v2. TR pazarı iyzico'da kalır.
# developer.paypal.com → Apps & Credentials → (Sandbox) uygulama → Client ID /
# Secret. Boşsa abonelik ve bilet ödemeleri gerçek API'ye gitmeden simüle edilir.
# Varsayılan SANDBOX; canlı API'ye yalnızca PAYPAL_LIVE_MODE=true ile gidilir
# (canlı uygulamanın kimlik bilgileriyle birlikte).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_LIVE_MODE=false
# Aynı uygulamanın Webhooks bölümünde https://<domain>/api/webhooks/paypal
# eklenince verilen Webhook ID (imza doğrulamasına girer; olay listesi
# app/api/webhooks/paypal/route.ts'te).
PAYPAL_WEBHOOK_ID=
# /kayit/us aboneliğinin PayPal billing plan kimliği (P-...). Önce bir ürün
# (Catalog Products), sonra aylık bir plan (Billing Plans) oluşturulur.
# PayPal anahtarları tanımlıyken zorunlu.
PAYPAL_US_PLAN_ID=

# Stripe — ESKİ ABD sağlayıcısı, şu an AKTİF DEĞİL (PayPal'a geçildi). Kod
# (lib/payments/stripe-provider.ts, /api/webhooks/stripe) referans olarak
# duruyor; geri dönmek için lib/payments/index.ts'te US satırı değişir.
# ŞU AN TEST MODUNDA: yalnızca sk_test_... anahtarı kullan (Stripe Dashboard →
# Developers → API keys, "Test mode" açıkken). Ödeme sayfası Stripe'ın hosted
# Checkout'u olduğundan publishable (pk_test_) anahtara gerek yok.
# Boşsa abonelik akışı gerçek API'ye gitmeden simüle edilir.
# sk_live_... anahtarı STRIPE_LIVE_MODE=true olmadıkça reddedilir.
STRIPE_SECRET_KEY=
# /api/webhooks/stripe imza doğrulaması (whsec_...). Yerelde
# `stripe listen --forward-to localhost:3001/api/webhooks/stripe` çıktısındaki
# değer; prod'da Dashboard'daki webhook endpoint'inin signing secret'ı.
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_MODE=false
# P6 — /kayit/us aboneliğinin Stripe fiyat kimliği (price_...). Stripe
# anahtarı tanımlıyken zorunlu; anahtar yoksa ödeme test modunda simüle edilir.
STRIPE_US_PRICE_ID=

# Locally sunucusu → Tideline API (/api/v1/internal/*: self-servis restoran +
# Twilio numarası kurulumu, admin numara kuyruğu). Servis token'ı
# TIDELINE_JWT_SECRET ile imzalanır. Boşsa ABD kayıtları "24 saat içinde"
# bekleme ekranına düşer ve admin /admin/tideline-kurulum'dan tamamlar.
TIDELINE_API_URL=http://localhost:3000

# Twilio (ABD SMS) — +1 numaralara giden bildirimler (ör. P7 kış modülü
# bildirimi) Netgsm yerine buradan gider. Boşsa e-postaya (Resend) düşer.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# AM — STOP/START/HELP (TCPA). Twilio Console'da TWILIO_FROM_NUMBER'ın
# "A message comes in" webhook'u: https://<domain>/api/webhooks/twilio/sms (POST).
# Kontrol/düzeltme: node scripts/twilio-sms-webhooks.mjs --locally-url ... --tideline-url ...
# Twilio imzayı çağırdığı adrese göre atar; proxy arkasında farklıysa sabitle:
TWILIO_SMS_WEBHOOK_URL=
# STOP'a yanıtı kim verir: boş = Twilio'nun kendi standart yanıtı (varsayılan, uzun
# numaralarda hep açık). "app" yalnızca Twilio'nun yanıtları kapatıldıysa.
TWILIO_OPT_OUT_REPLIES=

# ABD genel sayfaları (/terms, /privacy) ve SMS HELP yanıtındaki destek adresi — üretimde zorunlu.
NEXT_PUBLIC_US_SUPPORT_EMAIL=
NEXT_PUBLIC_US_LEGAL_ENTITY=
NEXT_PUBLIC_US_GOVERNING_LAW=
# AO — /privacy formundan gelen silme/erişim taleplerinin bildirim adresi
# (boşsa NEXT_PUBLIC_US_SUPPORT_EMAIL). Talepler her durumda /admin/gizlilik-talepleri'nde.
PRIVACY_REQUESTS_EMAIL=
