# Bu dosya .env.local için şablondur — gerçek değerler asla buraya yazılmaz,
# yalnızca anahtar isimleri ve ne işe yaradıkları. Kopyalayıp .env.local
# olarak kaydet, gerçek değerleri oraya gir (.env.local git'e gitmez).
#
# NOT: VERCEL_OIDC_TOKEN burada yok — `vercel env pull` çalıştırdığında
# Vercel CLI onu otomatik ekler, elle girilmez.

# Supabase — hepsi zorunlu, biri eksikse uygulama başlamaz (bkz. lib/env.ts)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Yalnız sunucu tarafında (cron işleri, admin RPC'leri) kullanılır, asla client'a sızdırılmaz
SUPABASE_SERVICE_ROLE_KEY=

# Şifre sıfırlama e-postasındaki bağlantının döneceği adres (prod'da gerçek domain)
NEXT_PUBLIC_SITE_URL=

# Vercel Cron uç noktalarını dıştan çağrılamaz yapan gizli anahtar
CRON_SECRET=

# SMS (Netgsm) — boşsa duyuru aracı test modunda simüle eder
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_MSGHEADER=

# E-posta (Resend) — boşsa duyuru aracı test modunda simüle eder
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# iyzico (marketplace/pazaryeri) — boşsa ödeme akışı test modunda simüle eder.
# PILOT_MODE=true olduğu sürece (bkz. lib/config/pilot.ts) zaten kullanılmaz.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=

# Claude (Anthropic) — işletme panelindeki AI kampanya metni asistanı için.
# Boşsa lib/ai/client.ts isAiConfigured() false döner ve asistan
# lib/ai/demo-content.ts'teki sabit örnek metinlerle simüle eder.
ANTHROPIC_API_KEY=
